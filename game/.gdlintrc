# gdlint configuration (pip install gdtoolkit ; run: gdlint src tests)
#
# The code base follows the official GDScript style guide with these deliberate exceptions:
#  * long lines: test assertions carry their message on the same line and draw code lists
#    polygon points inline, so line length is not enforced;
#  * member order: signals/constants/exports are grouped by topic (see game_tuning.gd), not by kind;
#  * _add() in theme_manager.gd is a flat data table row.
disable:
  - max-line-length
  - class-definitions-order
function-arguments-number: 14
