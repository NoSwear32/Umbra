; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Spire Sprint"
config/description="A momentum-driven endless tower climber. Landscape arcade game for Android."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
run/max_fps=0
boot_splash/bg_color=Color(0.043, 0.055, 0.106, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Events="*res://src/autoload/events.gd"
SaveManager="*res://src/autoload/save_manager.gd"
SettingsManager="*res://src/autoload/settings_manager.gd"
StatisticsManager="*res://src/autoload/statistics_manager.gd"
LeaderboardManager="*res://src/autoload/leaderboard_manager.gd"
CharacterManager="*res://src/autoload/character_manager.gd"
ReplayManager="*res://src/autoload/replay_manager.gd"
ThemeManager="*res://src/autoload/theme_manager.gd"
AudioManager="*res://src/autoload/audio_manager.gd"
SensorManager="*res://src/autoload/sensor_manager.gd"
InputManager="*res://src/autoload/input_manager.gd"
AndroidLifecycleManager="*res://src/autoload/android_lifecycle_manager.gd"
GameManager="*res://src/autoload/game_manager.gd"
UIManager="*res://src/autoload/ui_manager.gd"
DebugManager="*res://src/autoload/debug_manager.gd"

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/shadowed_variable_base_class=1
gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/energy_saving/keep_screen_on=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

buffering/agile_event_flushing=true
pointing/emulate_touch_from_mouse=true
sensors/enable_accelerometer=true
sensors/enable_gravity=true
sensors/enable_gyroscope=false
sensors/enable_magnetometer=false

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.043, 0.055, 0.106, 1)
